# NHL Goal Notifier Configuration
# Copy this file to .env and fill in your details. Never commit .env.

# Where goal alerts go: one or more Apprise URLs, separated by commas or spaces.
# See https://github.com/caronc/apprise/wiki for every supported service.
#   ntfy (no account needed; pick an unguessable topic):  ntfy://ntfy.sh/your-random-topic
#   self-hosted ntfy:                                      ntfys://ntfy.example.com/topic
NOTIFY_URLS=ntfy://ntfy.sh/replace-with-a-random-topic

# Legacy email-to-SMS (Telus gateway), used only when NOTIFY_URLS is empty.
# For Gmail, create an app password at https://myaccount.google.com/apppasswords
# PHONE_NUMBER=5550000000
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.email@gmail.com
# SMTP_PASSWORD=your_app_password_here

# Check interval in seconds (how often to check for goals)
CHECK_INTERVAL=30
